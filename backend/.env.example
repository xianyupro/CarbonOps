# CarbonOps Backend Environment
APP_NAME=CarbonOps
DEBUG=true
API_V1_PREFIX=/api/v1

# Database (SQLite)
DATABASE_URL=sqlite:///./carbonops.db

# JWT
SECRET_KEY=change-me-to-a-long-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# File upload
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=50

# Mock
SEED_ON_STARTUP=true
TS_BACKFILL_DAYS=7
TS_BACKFILL_INTERVAL_SECONDS=60
WS_PUSH_INTERVAL_SECONDS=5
